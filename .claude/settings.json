      "Bash(gh release:*)",
      "Bash(docker compose down:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(vercel:*)",
      "Bash(eas:*)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --delete:*)",
      "Bash(npm publish:*)",
      "Bash(pnpm publish:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)"
    ]
