# --- Claude / Anthropic (LLM) ---
# llm.py đọc ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key
# Tuỳ chọn: đổi model (mặc định claude-opus-4-8). Ví dụ: claude-sonnet-5
# Chỉ dùng khi TẮT định tuyến; khi router bật, model do độ khó quyết định.
ANTHROPIC_MODEL=claude-opus-4-8

# --- Định tuyến model theo độ khó (tối ưu chi phí) ---
# Bật mặc định. Đặt false để mọi request dùng Opus (ANTHROPIC_MODEL).
ANTHROPIC_ROUTER_ENABLED=true
# Ghi đè model từng tầng (tuỳ chọn):
# ANTHROPIC_MODEL_EASY=claude-haiku-4-5-20251001
# ANTHROPIC_MODEL_MEDIUM=claude-sonnet-5
# ANTHROPIC_MODEL_HARD=claude-opus-4-8

# --- RAG embeddings (tùy chọn) ---
HF_EMBEDDINGS_MODEL=keepitreal/vietnamese-sbert

# --- Model weights (tùy chọn, mặc định apps/ai-service/models) ---
# YOLO_MODEL_PATH=./models/vit_moe_best.pth
